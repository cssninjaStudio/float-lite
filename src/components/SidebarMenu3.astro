<ul id="business-menu" class="sidebar-menu" :class=`{
  'is-active': $store.app.activeSidebar === 'business',
  '': !$store.app.activeSidebar !== 'business'
}`>
  <!--Menu item-->
  <li class="menu-item" :class=`{
      'active': $store.app.activeSidebarMenu === 'projects-menu',
      '': !$store.app.activeSidebarMenu !== 'projects-menu'
  }`>
    <a @click.prevent="openSidebarMenu('projects-menu')" class="menu-link" href="javascript:void(0)">
      <iconify-icon class="iconify link-icon" icon="ph:projector-screen-chart-duotone"></iconify-icon>
      <span>Projects</span>
      <iconify-icon class="iconify link-caret" icon="feather:chevron-down"></iconify-icon>
    </a>
    <ul class="sub-menu" x-show="$store.app.activeSidebarMenu === 'projects-menu'" x-collapse>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-project-list">Project List</a>
      </li>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-project-grid">Project Grid</a>
      </li>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-project">Project Details</a>
      </li>
    </ul>
  </li>
  <!--Menu item-->
  <li class="menu-item" :class=`{
      'active': $store.app.activeSidebarMenu === 'crm-menu',
      '': !$store.app.activeSidebarMenu !== 'crm-menu'
  }`>
    <a @click.prevent="openSidebarMenu('crm-menu')" class="menu-link" href="javascript:void(0)">
      <iconify-icon class="iconify link-icon" icon="ph:crown-duotone"></iconify-icon>
      <span>CRM</span>
      <iconify-icon class="iconify link-caret" icon="feather:chevron-down"></iconify-icon>
    </a>
    <ul class="sub-menu" x-show="$store.app.activeSidebarMenu === 'crm-menu'" x-collapse>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-crm-segments">Segments</a>
      </li>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-crm-board">Kanban Board</a>
      </li>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-crm-deal">Deal</a>
      </li>
    </ul>
  </li>
  <!--Menu item-->
  <li class="menu-item" :class=`{
      'active': $store.app.activeSidebarMenu === 'contacts-menu',
      '': !$store.app.activeSidebarMenu !== 'contacts-menu'
  }`>
    <a @click.prevent="openSidebarMenu('contacts-menu')" class="menu-link" href="javascript:void(0)">
      <iconify-icon class="iconify link-icon" icon="ph:users-four-duotone"></iconify-icon>
      <span>Contacts</span>
      <iconify-icon class="iconify link-caret" icon="feather:chevron-down"></iconify-icon>
    </a>
    <ul class="sub-menu" x-show="$store.app.activeSidebarMenu === 'contacts-menu'" x-collapse>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-contact-list">Contact List</a>
      </li>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-contact-grid">Contact Grid</a>
      </li>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-contact">Contact Details</a>
      </li>
    </ul>
  </li>
