<nav
  class="icon-sidebar"
  x-data="initSidebar()"
  :class=`{
    'is-compact': $store.app.sidebarOpenedState,
    'is-icon-sidebar-translated-mobile': $store.app.isSidebarOpenedMobile,
    '': !$store.app.isSidebarOpenedMobile
}`
>
  <div class="icon-sidebar-inner">
    <ul>
      <li class="main-logo">
        <a href="/">
          <img src="/img/logo/logo.svg" class="light-image-block" alt="" />
          <img src="/img/logo/logo.svg" class="dark-image-block" alt="" />
        </a>
      </li>
      <li
        class="side-icon"
        @click="openSidebar('dashboard')"
        :class=`{
                'is-active': $store.app.activeSidebar == 'dashboard',
                '': !$store.app.activeSidebar != 'dashboard'
            }`
      >
        <div class="side-icon-inner mask mask-blob">
          <iconify-icon class="iconify" icon="ph:grid-four-duotone"></iconify-icon>
        </div>
      </li>
      <li
        class="side-icon"
        @click="openSidebar('accounting')"
        :class=`{
                'is-active': $store.app.activeSidebar == 'accounting',
                '': !$store.app.activeSidebar != 'accounting'
            }`
      >
        <div class="side-icon-inner mask mask-blob">
          <iconify-icon class="iconify" icon="ph:note-duotone"></iconify-icon>
        </div>
      </li>
      <li
        class="side-icon"
        @click="openSidebar('business')"
        :class=`{
                'is-active': $store.app.activeSidebar == 'business',
                '': !$store.app.activeSidebar != 'business'
            }`
      >
        <div class="side-icon-inner mask mask-blob">
          <iconify-icon class="iconify" icon="ph:briefcase-duotone"></iconify-icon>
        </div>
      </li>
      <li class="side-icon" @click="openSidebar('misc')" :class=`{
                'is-active': $store.app.activeSidebar == 'misc',
                '': !$store.app.activeSidebar != 'misc'
            }`>
        <div class="side-icon-inner mask mask-blob">
          <iconify-icon class="iconify" icon="ph:gear-six-duotone"></iconify-icon>
        </div>
      </li>
    </ul>

    <ul class="profile">
      <li>
        <!-- Profile avatar -->
        <a class="profile-trigger" href="javascript:" @click="toggleProfile()">
          <img
            class="icon-sidebar-avatar"
            src="/img/avatars/51.jpg"
            alt=""
            :class=`{
                      'vanish': $store.app.isProfileOpen,
                      '': !$store.app.isProfileOpen
                  }`
          />
          <span class="dot" :class=`{
                  'vanish': $store.app.isProfileOpen,
                  '': !$store.app.isProfileOpen
              }`></span>
        </a>

        <!-- Profile avatar -->
      </li>
    </ul>
  </div>
</nav>
