  <li class="menu-item" :class=`{
      'active': $store.app.activeSidebarMenu === 'forum-menu',
      '': !$store.app.activeSidebarMenu !== 'forum-menu'
  }`>
    <a @click.prevent="openSidebarMenu('forum-menu')" class="menu-link" href="javascript:void(0)">
      <iconify-icon class="iconify link-icon" icon="ph:chat-circle-text-duotone"></iconify-icon>
      <span>Forum</span>
      <iconify-icon class="iconify link-caret" icon="feather:chevron-down"></iconify-icon>
