        <a class="sub-menu-item" href="/#content-invoices-grid">Invoices Grid</a>
      </li>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-invoice">Invoice</a>
      </li>
    </ul>
  </li>
  <!--Menu item-->
  <li class="menu-item" :class=`{
      'active': $store.app.activeSidebarMenu === 'social-menu',
      '': !$store.app.activeSidebarMenu !== 'social-menu'
  }`>
    <a @click.prevent="openSidebarMenu('social-menu')" class="menu-link" href="javascript:void(0)">
      <iconify-icon class="iconify link-icon" icon="ph:confetti-duotone"></iconify-icon>
      <span>Social</span>
      <iconify-icon class="iconify link-caret" icon="feather:chevron-down"></iconify-icon>
    </a>
    <ul class="sub-menu" x-show="$store.app.activeSidebarMenu === 'social-menu'" x-collapse>
