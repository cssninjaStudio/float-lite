<ul id="documents-menu" class="sidebar-menu" :class=`{
  'is-active': $store.app.activeSidebar === 'accounting',
  '': !$store.app.activeSidebar !== 'accounting'
}`>
  <!--Menu item-->
  <li class="menu-item" :class=`{
      'active': $store.app.activeSidebarMenu === 'accounting-menu',
      '': !$store.app.activeSidebarMenu !== 'accounting-menu'
  }`>
    <a @click.prevent="openSidebarMenu('accounting-menu')" class="menu-link" href="javascript:void(0)">
      <iconify-icon class="iconify link-icon" icon="ph:calculator-duotone"></iconify-icon>
      <span>Accounting</span>
      <iconify-icon class="iconify link-caret" icon="feather:chevron-down"></iconify-icon>
    </a>
    <ul class="sub-menu" x-show="$store.app.activeSidebarMenu === 'accounting-menu'" x-collapse>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-bills-list">Bills List</a>
      </li>
      <!--Submenu item-->
      <li>
        <a class="sub-menu-item" href="/#content-bills-grid">Bills Grid</a>
      </li>
      <!--Submenu item-->
      <li>
