      <iconify-icon class="iconify link-icon" icon="ph:lifebuoy-duotone"></iconify-icon>
      <span>Support</span>
      <iconify-icon class="iconify link-caret" icon="feather:chevron-down"></iconify-icon>
    </a>
    <ul class="sub-menu" x-show="$store.app.activeSidebarMenu === 'support-menu'" x-collapse>
